{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Existing production Worker, confirmed in the Cloudflare dashboard.
  "name": "nesload",
  // 入口是根目录的 worker.ts（OpenNext 自定义 Worker）：包了一层 Cache API 边缘
  // 缓存压免费版 10ms CPU，见该文件头注释。⚠️ 它 import 的 `.open-next/worker.js`
  // 由 `pnpm cf:build` 生成 —— 别绕过 cf:build 直接 wrangler deploy。
  //
  // 🔴 2026-11-03 线上事故：这里曾经**同时存在两个 `main`** —— 2026-10-24 加
  //    `"main": "worker.ts"` 时没删下面那行 `"main": ".open-next/worker.js"`，
  //    而 JSONC 解析重复键取**最后一个**，于是 main 实际指向生成产物，
  //    `worker.ts` 那层边缘缓存从 10-24 起一直没生效过（注释和代码都是好的，
  //    只是没被加载）。表现就是「缓存明明 HIT，刷新同一页仍然 1102」：R2 命中
  //    省掉的只是查库，整个 Next handler 照跑，免费版 10ms 依然不够。
  //    改动这个键时先 grep 一遍有没有第二个 "main"，wrangler 不会报错。
  "main": "worker.ts",
  // Runtime variables are also maintained in the Cloudflare dashboard.
  // Preserve entries not explicitly listed in vars when publishing new code.
  "keep_vars": true,
  "compatibility_date": "2026-10-17",
  "compatibility_flags": ["nodejs_compat"],
  // 🔴 **2026-11-03 加：Workers Caching，把 Cloudflare 的两层缓存放在 Worker 前面。**
  //
  //    命中时 **Worker 一次都不执行** —— 不是「跑一遍再返回缓存」，是压根不启动 isolate。
  //    这正好治本：免费版 10ms CPU 下，连「加载 open-next 的 bundle + 初始化 18 张 i18n 表」
  //    都装不进去，所以 worker.ts 里那层 Cache API 即使 HIT，也一样要付冷启动的钱，
  //    照样 1102。日志里每天稳定的那批超时就是这么来的。
  //
  //    它默认是**两层**（本数据中心一层 + 全网汇总的上层），所以任意一个地方的一次
  //    成功填充之后，全球任何节点都能直接命中 —— 不像 `caches.default` 那样
  //    「每个 colo 各自冷一遍」。这是它能救长尾 URL 的原因。
  //
  //    按 RFC 9111 工作：认响应里的 `Cache-Control` / `Vary`。所以 worker.ts 必须
  //    把 HTML 副本的 `Vary` 收窄（Next 原始那串 `Vary` 含 `Next-Router-State-Tree`，
  //    每次导航都不同，照原样会被判成永不命中），并且给**不该被缓存的东西**显式
  //    `no-store`（私有页面、RSC、重定向）—— 详见 worker.ts 的 `withCdnHeaders`。
  //
  //    ⚠️ 命中**不计 CPU**，但按普通请求计数；免费版每天 10 万次，够用。
  //    ⚠️ 需要 Wrangler ≥ 4.69（本项目 4.151.1 ✓）。上传时报「cache 不支持」就是账号
  //       或版本问题，删掉这个块即可回退，代码不用动。
  //    ⚠️ 默认 `cross_version_cache: false` = 每次发版缓存命名空间独立，发版后仍会
  //       从冷开始。用 `scripts/warm-edge.mjs` 在部署后打一遍热门地址填上。
  "cache": { "enabled": true },
  // 部署版本号（2026-11-04）。worker.ts 的 `cacheVersion()` 把它拼进 Cache API 的键，
  // 让 `caches.default` 那一层也「发版即全部失效」。
  //
  // 为什么需要：`cross_version_cache: false` 只让上面那个 Workers Caching 发版清空，
  // 管不到 `caches.default` —— 那层的键原本是纯 URL，条目 TTL 24 小时**跨发版存活**，
  // 发版后依然返回上一版 HTML，而它引用的 chunk 已经随部署删了 ⇒ 全部 404。
  // 加了这个 binding 之后三层缓存（Workers Caching / Cache API / R2）都对齐了，
  // 发版后不再需要手动 purge 边缘缓存。
  //
  // ⚠️ `CF_VERSION_METADATA` 是 Cloudflare 的**保留名**，不能改成别的。
  // ⚠️ 取不到时 `cacheVersion()` 返回空串、键退回纯 URL（本地 dev 就是这种情形）。
  "version_metadata": { "binding": "CF_VERSION_METADATA" },
  "assets": { "directory": ".open-next/assets", "binding": "ASSETS" },
  "services": [{ "binding": "WORKER_SELF_REFERENCE", "service": "nesload" }],
  // ROM 桶的 binding（2026-11-05 加）。见 `lib/server/r2.ts` 的 `gamesBucket()`：
  // 走 binding 读，就不经过 `files.retrogamesbox.com` 前面那层 Cloudflare 缓存，
  // 也就不存在「冷对象忽略 Range、回 200 + 整个文件」这件事。
  // ⚠️ 绑定名 `GAMES_R2` 与 `lib/server/r2.ts` 的 `GAMES_BUCKET_BINDING` 必须逐字一致。
  // ⚠️ 桶名写死成 `games` 是刻意的：它和 `R2_BUCKET` 环境变量本来就是同一个桶，
  //    而 binding 只认部署配置里的字面量（读不到 `process.env`）。
  "r2_buckets": [
    { "binding": "NEXT_INC_CACHE_R2_BUCKET", "bucket_name": "nesload-next-cache" },
    { "binding": "GAMES_R2", "bucket_name": "games" }
  ],
  "durable_objects": {
    "bindings": [
      { "name": "NEXT_CACHE_DO_QUEUE", "class_name": "DOQueueHandler" },
      { "name": "NEXT_TAG_CACHE_DO_SHARDED", "class_name": "DOShardedTagCache" }
    ]
  },
  "migrations": [{ "tag": "next-cache-v1", "new_sqlite_classes": ["DOQueueHandler", "DOShardedTagCache"] }],
  "observability": { "enabled": true },
  "vars": {
    // 站点公网地址（canonical / og:image / sitemap 的绝对地址都由它拼）。
    // ⚠️ 2026-10-30 迁移：旧域 www.retrogamesonline.fun → www.retrogamesbox.com。
    "SITE_URL": "https://www.retrogamesbox.com",
    // R2 的公网读取域名（头像 / 封面 / ROM 都由它拼出来）。
    // ⚠️ 2026-10-19 线上事故：这个变量只在仪表盘里配过、后来掉了，于是带头像的账号
    // 一调 /api/user/* 就空 500，个人中心四个 tab 全打不开。写进这里跟代码一起发版，
    // 免得再靠「记得在仪表盘配一下」。它不是机密（浏览器天天在下载这些地址），
    // 所以放 vars 而不是 secrets；必须和 R2 那边绑定的自定义域名一致。
    // 2026-10-30 随站点迁域一起从 games.retrogamesonline.fun 换成 files.retrogamesbox.com
    // （库里图片只存路径、域名渲染时现拼，所以只换这一处就整体切换，见 lib/server/media.ts）。
    "R2_PUBLIC_BASE": "https://files.retrogamesbox.com",
    // Supabase 项目地址（库的所有查询都经它：HTTPS → PostgREST → exec_sql）。
    // ⚠️ 只有 URL 能写在这里 —— 密钥 `SUPABASE_SECRET_KEY` 必须用
    //    `wrangler secret put SUPABASE_SECRET_KEY`（仪表盘里同名 secret 也行），
    //    绝不能进这个文件 / 进仓库。少了它，全站读库会 500。
    // ⚠️ 2026-10-20 线上事故：数据层一度改成直连 pooler 的裸 TCP，Worker 里跑不通，
    //    所有动态接口一起 500。别再改回 TCP，见 lib/server/pg.ts 的文件头。
    "SUPABASE_URL": "https://olcnjvjyrrivikkrzatw.supabase.co",
    // 前台目录数据来源：upstream = 源站 retrogamesnexus.com（默认），d1 = 本站数据库。
    // 只影响首页 / 列表 / 详情 / 机种 / ROM；评论、收藏、后台、账号始终走 D1。
    // 想切回数据库改这里（或仪表盘里的同名变量）后重新发版即可，代码不用动。
    "CATALOG_SOURCE": "upstream",
    "NEXT_CACHE_DO_QUEUE_MAX_REVALIDATION": "1"
  }
}
