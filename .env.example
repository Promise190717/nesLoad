# 服务端环境变量 —— 复制为 .env.local 并填入真实值。
# 这些凭据只在 Next.js 服务端（API 路由 / middleware）使用，
# 一律**不要**加 NEXT_PUBLIC_ 前缀，否则会被打进客户端产物。

# ---- 站点公网地址（SEO，可选但公网部署建议填） ----
# 用途：metadataBase（canonical / og:image 的绝对地址）、sitemap.xml、
#      robots.txt 里那行 Sitemap。
# 静态构建不会读取请求 Host。未填时使用 https://www.retrogamesbox.com。
# 预览域名如需独立 canonical，需在构建环境显式设置。
SITE_URL=https://your-domain.com

# 构建时预生成的最新游戏数（每款包含四种语言和下载页）；0 = 全部按需生成。
STATIC_GAME_LIMIT=24

# ---- 前台目录数据从哪儿取（2026-10-19） ----
# upstream（默认）= 首页 / 游戏列表 / 详情 / 机种 / ROM 全部读源站 retrogamesnexus.com；
# d1              = 全部读本站 D1（改造前的行为）。
#
# ⚠️ 只影响**前台读取**。评论、收藏、历史、存档、账号、后台**始终走 D1** —— 那些源站没有。
# ⚠️ 认不出的值（含空着不写）按 upstream 处理，不会报错。
# ⚠️ 两种来源的游戏 id 不是一套（源站是 slug、D1 是 UUID）⇒ 切换后旧的收藏 / 历史
#    对不上是预期的，不要指望它能互相映射。
CATALOG_SOURCE=upstream

# ---- Cloudflare R2（S3 兼容上传） ----
R2_ENDPOINT=https://02a52e16b5681706e785f920fe5443e7.r2.cloudflarestorage.com
R2_BUCKET=games
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# R2 公网读取域名（拼图片 URL、回源 ROM）
R2_PUBLIC_BASE=https://files.retrogamesbox.com

# ---- ROM 上行出口（2026-10-22；Vercel 部署建议填） ----
# 为什么要有：上游那份 ROM 前面挂着 Cloudflare，风控是按**出口 IP**判的 ——
#   Cloudflare Workers 的出口就是 Cloudflare 自己的网段，取得到；
#   Vercel 函数跑在 AWS 上，机房 IP + 非浏览器 TLS 指纹，直接被挑战 / 403（接口回 502）。
# 填了之后：**上游那批 ROM 不从本服务出网**，改成请这个地址上的同一接口代取
#   （`<出口>/api/games/<id>/rom`，`?lang=` / `?disc=` / Range 原样转发），
#   本服务只把响应转给浏览器。R2 自持的那批不受影响（公网域名从哪儿都能取）。
# 值 = Cloudflare 上那份站点的根地址。空着 = 直连上游（本地 / Workers 部署的行为）。
# ⚠️ 出口那一跳自己**不要**再配这个变量，否则会自己指自己（代码里也挡了，但别依赖它）。
# ⚠️ 出口站点要跟自己同版本：接口路径变了这里就跟着变。
# ROM_EGRESS_ORIGIN=https://www.retrogamesbox.com
# ---- R2 上传走代理（可选；国内直连 R2 慢的时候用） ----
# 填了之后**只影响上传 / 删除**（S3 SDK 这两条走它），公网**读取不受影响**。
# 值是一个 HTTP 代理地址，本地开发常用 Clash / Mihomo 的混合端口：
#   R2_PROXY=http://127.0.0.1:7897
# ⚠️ S3 SDK 在 Node 下**不会**自己读 HTTPS_PROXY / HTTP_PROXY 环境变量，
#    必须显式传进来（见 lib/server/r2.ts 与 lib/server/proxy-agent.ts）。
# 只认 http(s) 代理，靠标准的 `CONNECT` 建隧道 —— 没引第三方包。
# 留空 = 直连（原行为）。

# ---- Cloudflare D1（REST API） ----
CF_ACCOUNT_ID=
CF_D1_API_TOKEN=
D1_DATABASE_ID=9ab0a67e-b4dc-4c7f-bdcb-8ee1ded8ffc4

# ---- Supabase（2026-10-20 起，全站唯一数据源） ----
# 只在服务端用，**不加 NEXT_PUBLIC_**。
#
# 📌 应用只走这一条路：HTTPS → PostgREST → `public.exec_sql` 函数
#    （`lib/server/pg.ts`；函数定义见 `db/schema.pg.sql` 末尾）。
#
# 为什么不直连 Postgres（这条 2026-10-20 踩过，别再改回去）：
#    · `db.<ref>.supabase.co` 只解析 IPv6，多数网络连不上；
#    · 换 pooler（`aws-n-<region>.pooler.supabase.com`）本地能通，但**线上 Worker 不行**——
#      Cloudflare Workers 里裸 TCP + TLS 建不起可用通道，上线当天全站 500；
#    · HTTPS 是 Workers 的原生能力，本地 / 线上同一套代码，没有「本地好好的、线上炸」。
#
# 代价：每次查询一次 HTTPS 往返，且没有事务。页面侧有 30 天 ISR 缓存兜着，够用；
#      真要事务就写成一条语句（`transaction()` 已经删了，因为当时没有调用方）。
SUPABASE_URL=
# Dashboard → Project Settings → API Keys → Secret keys（`sb_secret_...`）
# 老项目同一位置显示为 service_role。**它绕过 RLS，等于全库权限，绝不能进客户端。**
# 公开的那个（sb_publishable_ / anon）受 RLS 约束，服务端批量读写会到处 401，别用。
# ⚠️ `exec_sql` 的权限已经 revoke 掉 anon/authenticated，只留给 service_role ——
#    填错成公开 key 会直接报 `permission denied for function exec_sql`。
SUPABASE_SECRET_KEY=
#
# ⚠️ 下面这行**应用已经不读了**（`lib/server/pg.ts` 改成 HTTPS 之后）——
#    只有 `scripts/*.mjs`（爬取 / 回填 / 批量改数据）还在用它直连 pooler。
#    线上 Worker **不需要**配它；本地跑脚本时才填。
#    要用就走 Session pooler，**不要用 Dashboard 里 Direct connection 那条**：
#      · db.<ref>.supabase.co 只有 IPv6，多数网络连不上（实测本机 TCP 5432 直接 ENOENT）
#      · 用户名是 `postgres.<project-ref>` 不是 `postgres`
#      · aws-0 / aws-1 是**不同分片，猜不得**：抄错那个会报 `tenant/user ... not found`
#      · 连接时必须 `prepare: false`（transaction pooler 不支持预处理）
# SUPABASE_DB_URL=postgresql://postgres.<project-ref>:<password>@aws-<n>-<region>.pooler.supabase.com:5432/postgres

# ---- 后台会话签名密钥（随便一串长随机字符串） ----
SESSION_SECRET=

# ---- Cloudflare Turnstile 人机验证（前台登录 / 注册） ----
# 用途：挡住脚本批量注册和撞库，见 lib/server/turnstile.ts 与 components/TurnstileWidget.tsx。
#
# 从哪拿：https://dash.cloudflare.com → 左侧 Turnstile（不需要把域名托管到 Cloudflare，
#        Turnstile 可以独立用；免费注册个账号即可）→ Add widget →
#        填名字 + Hostnames（你的域名，本地调试可再加一行 localhost）→ Widget Mode 选 Managed。
#        建完就拿到一对密钥，两个都要填：
#   · Site Key   → NEXT_PUBLIC_TURNSTILE_SITE_KEY（必须加前缀，浏览器端要读出来画挂件）
#   · Secret Key → TURNSTILE_SECRET_KEY（**不加前缀**，只有服务端读）
#
# 免费额度：**校验次数不限**，够用得很。上限只有两条 —— 每个账号最多 20 个 widget、
#          每个 widget 最多 10 个 hostname（分析数据保留 7 天）。
#
# ⚠️ 这也是上面「服务端变量不加 NEXT_PUBLIC_」那条规矩的**例外之一**（另一个是 TURN）。
# ⚠️ **两个都空 = 彻底关掉验证**（本地开发的默认态）：前端不画挂件、服务端也不验。
#    只填一个 = 单边生效（画了不验 / 验了没画），上线前务必两个都确认 —— 忘配就是静默失效。
# ⚠️ 改完必须重新 build / 重启 dev server —— Next 只在构建期静态替换 NEXT_PUBLIC_* 字面量。
#
# 本地开发不想去注册 Cloudflare：用官方那对**测试密钥**即可（任何域名都能用，含 localhost）。
# ⚠️ 测试密钥只认测试密钥签出的假 token（`XXXX.DUMMY.TOKEN.XXXX`），**不能和真密钥混用**
#    —— 真 Secret 会拒掉假 token，反过来也一样。
# 想跳过验证（不画挂件）：两行都留空即可。
# 测试密钥（总是通过）：
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
# TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
# 另外两组（本地测失败分支用）：sitekey 2x00000000000000000000AB + secret 2x0000000000000000000000000000000AA 恒失败；
#                                sitekey 3x00000000000000000000FF 强制弹出交互式挑战。
# 正式密钥（去控制台建 widget 后填这里）：
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY=

# ---- 联机 TURN 中继（可选，但公网联机基本必需） ----
# ⚠️ 这也是上面那条规矩的**例外之一** —— 必须带 NEXT_PUBLIC_ 前缀，
#    因为要由浏览器端读出来交给 WebRTC 的 iceServers。
# 不配 = 只走 Trystero 自带的默认 STUN（Google + Cloudflare）：
#    同网段直连没问题，跨 NAT 打不通时会报 no-direct-connection。
# 配了 = 追加到 iceServers 里（STUN 不丢），直连失败时由它中继兜底。
# 改完必须重新 build / 重启 dev server —— Next 只在构建期静态替换字面量。
#
# URL 必须以 turn: 或 turns: 开头（Trystero 用 /^turns?:/i 判定）；
# 多个用逗号分隔，建议 udp + tcp 各来一条（有的网络封 UDP）。
# 例：turn:turn.example.com:3478?transport=udp,turn:turn.example.com:3478?transport=tcp
#
# ⚠️ NEXT_PUBLIC_* 会被打进客户端产物 —— 打开 DevTools 就能看到凭据，
#    别人可以拿你的 TURN 当免费中继。密码务必长随机，并给 coturn 限速。
# NEXT_PUBLIC_TURN_URL=
# NEXT_PUBLIC_TURN_USERNAME=
# NEXT_PUBLIC_TURN_CREDENTIAL=